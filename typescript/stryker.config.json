{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "https://endtoendtester.com/coverage/mutation-testing — scoped to two small modules on purpose: mutation testing is worth running on the code where a silent wrong answer is expensive, not on everything.",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": { "projectType": "custom", "configFile": "jest.config.js" },
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/coverage/code-coverage/money.ts",
    "src/coverage/coverage-metrics/shipping.ts"
  ],
  "timeoutMS": 60000,
  "concurrency": 2
}
